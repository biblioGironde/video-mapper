{
  "name": "video-mapper",
  "productName": "Video Mapper",
  "version": "1.0.0",
  "description": "Vidéo-mapping : calques vidéo avec alpha, calibration p5.mapper, sortie plein écran pour vidéoprojecteur",
  "main": "main.js",
  "author": "Julien Drochon",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:mac-intel": "electron-builder --mac --x64",
    "dist:win": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:win-portable": "electron-builder --win zip --x64"
  },
  "build": {
    "appId": "fr.biblio-gironde.videomapper",
    "productName": "Video Mapper",
    "copyright": "Video Mapper — p5.js, p5.mapper (MIT), OpenCV.js (Apache 2.0)",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "identity": "-",
      "artifactName": "VideoMapper-${version}-macOS-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "VideoMapper-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Video Mapper",
      "artifactName": "VideoMapper-Installer-${version}.${ext}",
      "language": "1036"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Video",
      "icon": "build/icon.png",
      "artifactName": "VideoMapper-${version}-Linux-${arch}.${ext}"
    },
    "publish": null
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/biblioGironde/video-mapper.git"
  },
  "homepage": "https://bibliogironde.github.io/video-mapper/"
}